{
  "name": "@finans/e2e",
  "version": "1.0.0",
  "description": "Finans end-to-end tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:full": "playwright test --project=full",
    "test:watch": "playwright test --headed --timeout=0",
    "test:screenshots": "npx cross-env SCREENSHOTS=1 playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

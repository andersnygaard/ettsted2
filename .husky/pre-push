#!/usr/bin/env sh

# Pre-push hook: Run lint, type-check, and build before pushing
# Warnings are OK, errors block the push

echo "Running pre-push checks..."

# Lint all workspaces (warnings OK, errors block)
echo "Linting..."
pnpm lint || exit 1

# Type-check all workspaces
echo "Type-checking..."
pnpm type-check || exit 1

# Build all workspaces
echo "Building..."
pnpm build || exit 1

echo "Pre-push checks passed!"

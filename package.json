{
  "name": "finans",
  "version": "1.0.0",
  "description": "Portfolio and wealth tracking application for monthly monitoring of investments and net worth",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "type-check": "pnpm --filter frontend type-check && pnpm --filter backend type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:e2e": "pnpm --filter e2e test",
    "db:seed": "pnpm --filter backend db:seed"
  },
  "keywords": [
    "portfolio",
    "finance",
    "investment",
    "FIRE",
    "wealth-tracking"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.57.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
